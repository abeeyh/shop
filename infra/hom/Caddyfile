# HTTPS automático (Let's Encrypt) para o domínio do .env (#123). Cookies de sessão exigem HTTPS fora de local.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000 {
		# header confiável com o IP real: o cliente não consegue forjar (CLIENT_IP_HEADER=x-real-ip)
		header_up X-Real-IP {remote_host}
	}
}
