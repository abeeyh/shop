# Copie para .env.local. Nunca commitar valores reais. Validado em src/lib/env.ts.

# local | homologacao | production
APP_ENV=local
# tag da release (preenchida pelo CI)
APP_RELEASE=dev
# fatal | error | warn | info | debug (padrão: info em production, debug nos outros)
LOG_LEVEL=

# IP do cliente: header que a CDN/proxy SOBRESCREVE (ex.: cf-connecting-ip). Obrigatório em production.
# Vazio em local/homologação = x-forwarded-for (forjável; só para desenvolvimento).
CLIENT_IP_HEADER=
# Segredo das rotas /api/cron/* (mín. 32 caracteres): Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Better Stack (docs/16 §8) — vazio = só stdout
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGEST_HOST=

# Banco e cache locais (compose.yaml). DATABASE_URL é obrigatória para quem usa src/db
DATABASE_URL=postgres://shop:shop@localhost:5433/shop
# Obrigatório em production (rate limit — docs/09 §2)
VALKEY_URL=redis://localhost:6380
